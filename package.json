{
  "name": "SuperLcm",
  "version": "0.5.27",
  "description": "\u4e3a DSH \u4fdd\u5b58\u5b8c\u6574\u539f\u6587\u3001\u751f\u6210\u540e\u53f0\u5206\u5c42\u6458\u8981\u5e76\u7cbe\u786e\u53ec\u56de\u3002\u6458\u8981\u548c\u53ef\u9009\u538b\u7f29\u5747\u5728\u63d2\u4ef6\u8bbe\u7f6e\u9875\u7ba1\u7406\u3002",
  "type": "module",
  "main": "./src/runtime.js",
  "exports": {
    ".": "./src/runtime.js",
    "./tool": "./src/tool.js",
    "./core": "./src/core.js",
    "./marker": "./src/marker.js",
    "./store": "./src/store.js",
    "./client": "./lib/client.js",
    "./engine": "./src/engine.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "src/",
    "docs/*.md",
    "examples/",
    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "docs/images/icon.svg",
    "docs/images/*.gif"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-connection"
      ],
      "external": [
        "@deepseek-ai/dsh-client-connection/client"
      ]
    }
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --experimental-loader ./scripts/host-loader.mjs --test test/standalone*.test.js",
    "validate": "npm run check && npm test",
    "pack:check": "npm pack --dry-run",
    "test:install": "node --experimental-loader ./scripts/host-loader.mjs scripts/smoke-install.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context-compaction",
    "SuperLcm",
    "lossless-recall",
    "lossless-context",
    "memory",
    "dag"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yu381792/dsh-superlcm.git"
  },
  "bugs": {
    "url": "https://github.com/yu381792/dsh-superlcm/issues"
  },
  "homepage": "https://github.com/yu381792/dsh-superlcm#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "*",
    "@deepseek-ai/dsh-session-query": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-llm-pi-ai": "*",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "*",
    "@deepseek-ai/dsh-llm-deepseek-account": "*",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "*",
    "@deepseek-ai/dsh-session-format-v1-to-v2": "*",
    "@deepseek-ai/dsh-session-format-v2-to-v3": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-deepseek-api-key": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-deepseek-account": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format-v0-to-v1": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format-v1-to-v2": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-format-v2-to-v3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.1"
  }
}
